# -----------------------------------------------------------------------------
# GIA PHẢ NGUYỄN VĂN - MẪU BIẾN MÔI TRƯỜNG CẤU HÌNH
# -----------------------------------------------------------------------------
# Copy file này thành .env.local và điền giá trị thật.

SITE_NAME="Gia Phả Nguyễn Văn"

# Supabase: Project URL và publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-anon-or-publishable-key"

# Đặt true để ẩn nút đăng nhập Google/Facebook nếu chưa cấu hình SSO.
NEXT_PUBLIC_DISABLE_SSO="true"

# URL public dùng trong liên kết duyệt tài khoản gửi qua email.
APP_URL="https://your-domain.vercel.app"

# Server-only. Không đưa secret/service_role key lên client hoặc Git.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server-only: PostgreSQL connection string cho công cụ migration.
SUPABASE_DB_URL="postgresql://postgres.your-project:password@your-host:5432/postgres"

# Resend dùng để gửi email thông báo cho admin.
RESEND_API_KEY="re_your-api-key"
RESEND_FROM_EMAIL="Gia Phả Nguyễn Văn <no-reply@your-verified-domain.com>"

# Tuỳ chọn: nhiều địa chỉ email, ngăn cách bằng dấu phẩy.
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
